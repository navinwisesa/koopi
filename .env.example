# Copy to .env.local and fill in from your Supabase project's Settings → API.
# Both values are safe to expose in browser code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Groq API key (server-side only) — https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# OpenRouter API key (server-side only, optional) — fallback provider used only
# when Groq itself fails (e.g. daily quota exhausted). Without this set, a Groq
# failure surfaces as a visible chat message instead of failing over.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# E2B sandbox key, for the run_code tool (server-side only) — https://e2b.dev/dashboard
E2B_API_KEY=e2b_...
