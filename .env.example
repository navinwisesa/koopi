# Copy to .env.local and fill in from your Supabase project's Settings → API.
# Both values are safe to expose in browser code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Groq API key (server-side only, optional) — primary provider for non-code
# replies (Efficient/Powerful mode). https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# OpenRouter API key (server-side only, optional) — sole provider for code
# replies (cohere/north-mini-code), and fallback for Efficient/Powerful when
# Groq fails. Without either key set, a failure surfaces as a visible chat
# message instead of a reply. https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# E2B sandbox key, for the run_code tool (server-side only) — https://e2b.dev/dashboard
E2B_API_KEY=e2b_...

# Tavily API key, for the web_search tool (server-side only) — without it,
# web_search returns a plain "not configured" error instead of crashing.
# https://tavily.com
TAVILY_API_KEY=tvly-...
